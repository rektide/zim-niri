# Upsert whitelisted vars into systemd user environment (only changes differing values).
# Skips entirely when a hash of current values matches the last import.
# Customize in zimrc before loading the module:
#   zstyle ':zim:niri' systemd-env-vars NIRI_SOCKET WAYLAND_DISPLAY DISPLAY
local -a vars
zstyle -a ':zim:niri' systemd-env-vars vars || vars=(NIRI_SOCKET WAYLAND_DISPLAY)

local current_hash=
local val
for var in $vars; do
  val=${(P)var:-}
  current_hash+=${#val}:${val},
done
current_hash=$(printf '%s' "$current_hash" | command md5sum | command cut -d' ' -f1)

local cache_file=${XDG_RUNTIME_DIR:-/run/user/${UID}}/zim-niri-sync-env.hash
if [[ -r $cache_file ]] && read -r cached_hash < $cache_file && [[ $cached_hash == $current_hash ]]; then
  return
fi

local -A sd_env
local line k v
for line in ${(f)"$(systemctl --user show-environment)"}; do
  k=${line%%=*} v=${line#*=}
  sd_env[$k]=$v
done

local -a changed
for var in $vars; do
  (( ${(P)+var} )) && [[ ${(P)var} != ${sd_env[$var]} ]] && changed+=$var
done

(( $#changed )) && systemctl --user import-environment ${(@)changed}
printf '%s' "$current_hash" >| $cache_file
